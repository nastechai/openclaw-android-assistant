<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <!-- ── Terminal layer ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/terminalLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Scrollable output -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0a0a0a"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@android:color/darker_gray"
            android:overScrollMode="never"
            android:fillViewport="true">

            <TextView
                android:id="@+id/terminalOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#e2e8f0"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.1"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:textIsSelectable="true" />

        </ScrollView>

        <!-- Input row -->
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#111111"
            android:padding="4dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/inputField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="#e2e8f0"
                android:textColorHint="#64748b"
                android:hint="command…"
                android:textSize="13sp"
                android:background="@null"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:imeOptions="actionSend"
                android:maxLines="1"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/enterButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@null"
                android:tint="#818cf8"
                android:contentDescription="Enter" />

        </LinearLayout>
    </LinearLayout>

    <!-- ── Loading overlay (shown during install) ─────────────────────── -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#0a0a0a">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#818cf8" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_initializing"
            android:textColor="#94a3b8"
            android:textSize="16sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
